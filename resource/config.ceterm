# CETerm 默认配置(保底配置)
#
# 用户配置:%LOCALAPPDATA%\CETerm\config.ceterm
#   存在且可读 = 只执行用户配置(完全替代本文件);缺失/读失败 = 执行本文件。
# 语法:一行 = 一条命令(与 F2 命令栏完全相同);行首 # 或 // 为注释;help 查看全部命令。
# 执行:逐行顺序执行,不分相位 —— 顺序由本文件自己负责:需要窗格的命令
#       (split/font/launch/page-*)必须写在 page-new 之后。
# 分片:load "<path>" 引入其它命令文件(相对路径 = 相对本文件所在目录)。

# ---- 主题库(内置 8 套配色,外部数据)----
load "themes.ceterm"

# ---- 外观与启动 ----
theme tango-dark
# 逐项覆盖主题(theme-set "<名字>" <字段> <#RRGGBB>;名字不存在则新建):
# theme-set "mine" bg "#101014"
# theme-set "mine" fg "#D0D0D0"
# theme-set "mine" ansi3 "#C4A000"     # ansi0..ansi15
# theme-set "mine" tab_active_bg "#101014"
# theme mine
default-launch "zsh" "FiraCode Nerd Font Mono" 22
vsync on
borderless off
bgshader

cwd "C://Users/GroupTheory"

# ---- 焦点(Alt + HJKL)----
bind alt+h "focus left"
bind alt+l "focus right"
bind alt+k "focus up"
bind alt+j "focus down"

# ---- 分屏(Alt+Shift + HJKL;left/up = 新窗在首侧)----
bind alt+shift+h "split left"
bind alt+shift+l "split right"
bind alt+shift+k "split up"
bind alt+shift+j "split down"

# ---- 交换窗口内容(Ctrl+Shift + HJKL)----
bind ctrl+shift+h "exchange left"
bind ctrl+shift+l "exchange right"
bind ctrl+shift+k "exchange up"
bind ctrl+shift+j "exchange down"

# ---- 关窗 / 新建页 ----
bind ctrl+shift+w "destroy"
bind ctrl+shift+t "page-new"

# ---- 历史翻页 ----
bind shift+pageup "reviewup"
bind shift+pagedown "reviewdown"

# ---- 命令栏 ----
bind f2 "toggle-commandbar"

# ---- 选区 ----
bind ctrl+shift+c "copy"
bind ctrl+shift+v "paste"
bind ctrl+shift+a "selectall"

# ---- 字号 ----
bind ctrl+shift+= "fontsizeup"
bind ctrl+shift+- "fontsizedown"

# ---- 页签切换 ----
bind ctrl+tab "page-next"
bind ctrl+shift+tab "page-prev"
bind alt+1 "page 1"
bind alt+2 "page 2"
bind alt+3 "page 3"
bind alt+4 "page 4"
bind alt+5 "page 5"
bind alt+6 "page 6"
bind alt+7 "page 7"
bind alt+8 "page 8"
bind alt+9 "page 9"

# ---- 窗口装饰 / 显示模式 ----
bind alt+f "borderless"
bind alt+s "single"

# ---- 第一页(建页 + 根窗格;根窗格按上面的 default-launch 启动)----
page-new
