# dterm 默认配置(保底配置)
#
# 用户配置:%APPDATA%\dterm\config.dterm
#   存在且可读 = 只执行用户配置(完全替代本文件);缺失/读失败 = 执行本文件。
# 语法:一行 = 一条命令(与 F2 命令栏完全相同);行首 # 或 // 为注释;help 查看全部命令。
# 加载相位:本文件里"全局命令"(主题/字体/键位/装饰/默认启动)在建第一页之前执行,
#           窗口与页命令(split/font/launch/page-*)在建第一页之后按顺序执行。

# ---- 外观与启动 ----
theme tango-dark
default-launch "bash" "FiraCode Nerd Font Mono" 26
vsync on
borderless off
bgshader

# ---- 焦点(Alt + HJKL)----
bind alt+h "focus left"
bind alt+l "focus right"
bind alt+k "focus up"
bind alt+j "focus down"

# ---- 分屏(Alt+Shift + HJKL;left/up = 新窗在首侧)----
bind alt+shift+h "split left"
bind alt+shift+l "split right"
bind alt+shift+k "split up"
bind alt+shift+j "split down"

# ---- 交换窗口内容(Ctrl+Shift + HJKL)----
bind ctrl+shift+h "exchange left"
bind ctrl+shift+l "exchange right"
bind ctrl+shift+k "exchange up"
bind ctrl+shift+j "exchange down"

# ---- 关窗 / 新建页 ----
bind ctrl+shift+w "destroy"
bind ctrl+shift+t "page-new"

# ---- 历史翻页 ----
bind shift+pageup "reviewup"
bind shift+pagedown "reviewdown"

# ---- 命令栏 ----
bind f2 "toggle-commandbar"

# ---- 选区 ----
bind ctrl+shift+c "copy"
bind ctrl+shift+v "paste"
bind ctrl+shift+a "selectall"

# ---- 字号 ----
bind ctrl+shift+= "fontsizeup"
bind ctrl+shift+- "fontsizedown"

# ---- 页签切换 ----
bind ctrl+tab "page-next"
bind ctrl+shift+tab "page-prev"
bind alt+1 "page 1"
bind alt+2 "page 2"
bind alt+3 "page 3"
bind alt+4 "page 4"
bind alt+5 "page 5"
bind alt+6 "page 6"
bind alt+7 "page 7"
bind alt+8 "page 8"
bind alt+9 "page 9"

# ---- 窗口装饰 / 显示模式 ----
bind alt+f "borderless"
bind alt+s "single"
