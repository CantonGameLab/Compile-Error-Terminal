# CETerm 主题库(内置主题数据;由 config.ceterm 用 load "themes.ceterm" 引入)
#
# 一行 = 一条 theme-set 命令:<主题名> <字段> <#RRGGBB>;字段名 = Theme 结构体字段。
# 自动建槽:名字首次出现即创建;theme <name> 激活。用户可在自己的配置里覆盖任意字段。

# ---- default ----
theme-set "default" ansi0 "#000000"
theme-set "default" ansi1 "#800000"
theme-set "default" ansi2 "#008000"
theme-set "default" ansi3 "#808000"
theme-set "default" ansi4 "#000080"
theme-set "default" ansi5 "#800080"
theme-set "default" ansi6 "#008080"
theme-set "default" ansi7 "#C0C0C0"
theme-set "default" ansi8 "#808080"
theme-set "default" ansi9 "#FF0000"
theme-set "default" ansi10 "#00FF00"
theme-set "default" ansi11 "#FFFF00"
theme-set "default" ansi12 "#0000FF"
theme-set "default" ansi13 "#FF00FF"
theme-set "default" ansi14 "#00FFFF"
theme-set "default" ansi15 "#FFFFFF"
theme-set "default" fg "#DCDCDC"
theme-set "default" bg "#1E1E1E"
theme-set "default" cursor "#FFFFFF"
theme-set "default" frame "#FFFF00"
theme-set "default" focus_border "#4FC3F7"
theme-set "default" fps_bg "#101418"
theme-set "default" fps_fg "#9FBFD8"
theme-set "default" tab_bar_bg "#16161C"
theme-set "default" tab_fg "#8A8F98"
theme-set "default" tab_active_bg "#1E1E1E"
theme-set "default" tab_active_fg "#EAEAEA"
theme-set "default" tab_hover_bg "#26262E"
theme-set "default" selection_bg "#264F78"
theme-set "default" selection_fg "#FFFFFF"

